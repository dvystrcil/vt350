# BTT Octopus Pro v1.1, STM32H723 (the printer's main MCU, `mcu` in printer.cfg).
# Settings from Kalico's config/generic-bigtreetech-octopus-pro-v1.1.cfg header (Kalico 991e182):
# STM32H723, 128KiB bootloader, 25 MHz crystal; USB on PA11/PA12 (the board's USB-C port).
CONFIG_LOW_LEVEL_OPTIONS=y
CONFIG_MACH_STM32=y
CONFIG_MACH_STM32H723=y
CONFIG_STM32_FLASH_START_20000=y
CONFIG_STM32_CLOCK_REF_25M=y
CONFIG_STM32_USB_PA11_PA12=y
