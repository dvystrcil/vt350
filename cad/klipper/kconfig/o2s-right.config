# Orbitool O2S toolboard, STM32F072, on the right head (`mcu o2s_right` in printer.cfg).
# Settings from the O2S User Manual v1.5 section 4 and Orbiter-Toolboards @ 52a5a33 (CC0-1.0):
# STM32F072, no bootloader (flashed over DFU), 12 MHz crystal, USB on PA11/PA12.
# The USB serial number differs from upstream's single "Orbitool_O2S": with two boards, both would enumerate as
# /dev/serial/by-id/usb-Klipper_stm32f072xb_Orbitool_O2S-if00 and collide. This board's is Orbitool_O2S_R.
CONFIG_LOW_LEVEL_OPTIONS=y
CONFIG_MACH_STM32=y
CONFIG_MACH_STM32F072=y
CONFIG_STM32_FLASH_START_0000=y
CONFIG_STM32_CLOCK_REF_12M=y
CONFIG_STM32_USB_PA11_PA12=y
# CONFIG_USB_SERIAL_NUMBER_CHIPID is not set
CONFIG_USB_SERIAL_NUMBER="Orbitool_O2S_R"
